{
  "family": "graph",
  "workload": "graph.ogbg-molhiv",
  "seed": 7,
  "epochs": 100,
  "workload_options": {"root": "data/ogb", "batch_size": 64, "workers": 4, "width": 128, "layers": 4, "partition": "iid"},
  "method": {
    "name": "anderson-adaptive",
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "optimizer_options": {"weight_decay": 0.00001},
    "scheduler": {"name": "cosine", "eta_min": 0.00001},
    "acceleration": {"acceleration_type": "anderson", "wait_iterations": 50, "history_depth": 8, "frequency": 20, "reg_acc": 1e-6, "sketch_fraction": 0.05, "sketch_policy": "backward_error"}
  },
  "output": {"directory": "results/ogbg-molhiv", "save_trace": true},
  "tags": {"dataset": "ogbg-molhiv", "study": "graph-property-prediction"}
}
