{
  "family": "vision",
  "workload": "vision.imagenet",
  "seed": 7,
  "epochs": 90,
  "workload_options": {"root": "/path/to/imagenet", "batch_size": 256, "workers": 8, "download": false, "partition": "iid", "max_eval_batches": 1000000},
  "method": {
    "name": "anderson-adaptive",
    "optimizer": "sgd",
    "learning_rate": 0.1,
    "optimizer_options": {"momentum": 0.9, "weight_decay": 0.0001},
    "scheduler": {"name": "multistep", "milestones": [30, 60, 80], "gamma": 0.1},
    "acceleration": {"acceleration_type": "anderson", "wait_iterations": 100, "history_depth": 10, "frequency": 50, "reg_acc": 1e-7, "sketch_fraction": 0.01, "sketch_policy": "backward_error"}
  },
  "output": {"directory": "results/imagenet", "save_trace": true},
  "tags": {"dataset": "ImageNet-1k", "study": "large-scale-vision"}
}
