{
  "family": "transformer",
  "workload": "transformer.wikitext103",
  "seed": 7,
  "epochs": 20,
  "workload_options": {"root": "data/huggingface", "batch_size": 16, "sequence_length": 128, "max_train_tokens": 10000000, "max_eval_tokens": 1000000, "width": 256, "layers": 4, "offline": false},
  "method": {
    "name": "anderson-adaptive",
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "optimizer_options": {"weight_decay": 0.01},
    "scheduler": {"name": "cosine", "eta_min": 0.00001},
    "acceleration": {"acceleration_type": "anderson", "wait_iterations": 100, "history_depth": 8, "frequency": 50, "reg_acc": 1e-6, "sketch_fraction": 0.02, "sketch_policy": "backward_error", "mixing_dtype": "float32"}
  },
  "output": {"directory": "results/wikitext103", "save_trace": true},
  "tags": {"dataset": "WikiText-103", "study": "language-modeling"}
}
